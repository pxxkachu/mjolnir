# Mjolnir — xcaddy-built Caddy (Porkbun DNS-01)
# Pattern matches dxp480tp post_install.md §14 (official Caddy unit).
# Do NOT set NoNewPrivileges=true — it breaks binding :443.
# Serves https://ai.lehaus.io → llama-server 127.0.0.1:8080

[Unit]
Description=Caddy
Documentation=https://caddyserver.com/docs/
After=network-online.target
Requires=network-online.target

[Service]
Type=notify
User=caddy
Group=caddy
Environment=HOME=/var/lib/caddy
Environment=XDG_CONFIG_HOME=/var/lib/caddy
EnvironmentFile=/var/lib/caddy/porkbun.env
ExecStart=/usr/local/bin/caddy run --environ --config /var/lib/caddy/Caddyfile
ExecReload=/usr/local/bin/caddy reload --config /var/lib/caddy/Caddyfile --force
TimeoutStopSec=5s
LimitNOFILE=1048576
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/caddy
PrivateTmp=true

[Install]
WantedBy=multi-user.target
