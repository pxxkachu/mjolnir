# Mjolnir — HTTPS for llama-server on Tailscale
# Same xcaddy / Porkbun pattern as dxp480tp post_install.md §14
# DNS: A ai.lehaus.io → Tailscale 100.x (Porkbun)
# Plugin: github.com/caddy-dns/porkbun → /usr/local/bin/caddy

{
	email admin@lehaus.io
	acme_dns porkbun {
		api_key {env.PORKBUN_API_KEY}
		api_secret_key {env.PORKBUN_SECRET_API_KEY}
	}
}

(tailnet) {
	@blocked not remote_ip 100.64.0.0/10
	respond @blocked "Unauthorized" 403
	tls {
		resolvers 1.1.1.1
	}
}

ai.lehaus.io {
	import tailnet
	encode gzip
	reverse_proxy 127.0.0.1:8080
}
