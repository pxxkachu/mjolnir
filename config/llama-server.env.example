# Installed to /etc/llama-server.env (optional extras for future flags).
# Model path is fixed by the unit: /home/<user>/models/active.gguf
#
#   mkdir -p ~/models
#   # download a GGUF, then:
#   ln -sfn ~/models/your-model.Q4_K_M.gguf ~/models/active.gguf
#   sudo systemctl enable --now llama-server
#   curl -fsS https://ai.lehaus.io/v1/models
